# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=viet_acosla
MYSQL_USER=vietauto_user
MYSQL_PASSWORD=change-me-app-db-password
# Chỉ dùng khi khởi tạo container mysql (docker compose)
MYSQL_ROOT_PASSWORD=change-me-root-password
# Schema đúng theo infra/mysql/init.sql — DB cũ lệch cột: npm run db:reset

# JWT
JWT_SECRET=replace-this-in-production
JWT_EXPIRES_IN=7d
# (Tuỳ chọn) Ký link xem biên lai Premium; mặc định dùng JWT_SECRET
# PREMIUM_PROOF_SECRET=

# Ports
API_GATEWAY_PORT=8080
QUIZ_SERVICE_PORT=4001
MEDIA_SERVICE_PORT=4002
USER_SERVICE_PORT=4003
STATS_SERVICE_PORT=4004
MATERIALS_SERVICE_PORT=4005
WEB_PORT=3000

# Service URLs
USER_SERVICE_URL=http://localhost:4003
QUIZ_SERVICE_URL=http://localhost:4001
MEDIA_SERVICE_URL=http://localhost:4002
STATS_SERVICE_URL=http://localhost:4004
MATERIALS_SERVICE_URL=http://localhost:4005

# Media / CDN
MEDIA_STORAGE_DIR=./storage
CDN_BASE_URL=http://localhost:8080
PUBLIC_WEB_ORIGIN=http://localhost:8080

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Server-side fetch/rewrite của Next (cache-api, sitemap, metadata)
INTERNAL_API_BASE_URL=http://localhost:8080
API_ORIGIN=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=vietautoescuela@gmail.com
NEXT_PUBLIC_PREMIUM_INBOX_EMAIL=vietautoescuela@gmail.com

# Google OAuth (user-service) — điền Client ID + Secret từ Google Cloud; Authorized redirect URI phải trùng GOOGLE_OAUTH_REDIRECT_URI; restart user-service
GOOGLE_CLIENT_ID=
# Bắt buộc cho luồng server: lấy tại Google Cloud → Credentials → OAuth 2.0 Client IDs → mở client → Client secret (hoặc Reset nếu mất)
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/oauth/google/callback

# Nút liên hệ nổi (WhatsApp / Zalo) — tùy chọn
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/34XXXXXXXXX
# NEXT_PUBLIC_ZALO_URL=https://zalo.me/84XXXXXXXXX

# Premium & quên mật khẩu: gửi mail qua Resend (https://resend.com/api-keys)
PREMIUM_NOTIFY_EMAIL=vietautoescuela@gmail.com
RESEND_API_KEY=
# Địa chỉ @ phải khớp domain đã verify trên Resend (gửi được mọi người nhận). Chưa verify: tạm dùng onboarding@resend.dev (chỉ test tới email tài khoản Resend).
RESEND_FROM="Viet Autoescola <noreply@vietautoescuela.com>"
